{"nodes": [{"id": "_github_workflows_mantener_despierto", "label": "Workflow: Mantener el servicio despierto", "file_type": "code", "source_file": ".github/workflows/mantener-despierto.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HF free-tier Spaces sleep after ~48h idle; cold start (TensorFlow + model load) exceeds the UI's 15 s timeout and looks like an error. Pings every 6 h at minute 17: tolerates 7 missed runs, avoids top-of-hour load, costs ~122 of 2000 free minutes/month. Also the only automatic monitoring: fails (emailing owner) if not healthy, no model loaded, or patients != 123."}, {"id": "_github_workflows_mantener_despierto_hf_space_inference_service", "label": "HF Space evoshell-api-ecg-forecasting", "file_type": "concept", "source_file": ".github/workflows/mantener-despierto.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_mantener_despierto_cold_start_sleep", "label": "HF Space sleep / cold start (48 h idle)", "file_type": "rationale", "source_file": ".github/workflows/mantener-despierto.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waking requires loading TensorFlow and the model (tens of seconds); frontend abandons request at 15 s so cold start appears as an error."}], "edges": [{"source": "_github_workflows_mantener_despierto", "target": "forecasting_ecg___dashboard_ecg_forecast_api_readme_api_health", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/mantener-despierto.yml", "source_location": "L96", "weight": 1.0}, {"source": "_github_workflows_mantener_despierto", "target": "forecasting_ecg___dashboard_ecg_forecast_api_readme_api_patients", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/manten